{
  "name": "tcl-syntax",
  "displayName": "TCL Syntax",
  "description": "Tcl language support with IntelliSense, formatting, debugging, testing, and project tools",
  "version": "0.8.0",
  "icon": "images/tcl_plugin_logo_512.png",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "tcl",
    "tk",
    "expect"
  ],
  "publisher": "amos-anderson",
  "author": {
    "name": "Amos Anderson",
    "email": "amosanderson@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AmosAnderson/tcl_vscode"
  },
  "activationEvents": [
    "onLanguage:tcl",
    "onDebugResolve:tcl",
    "onDebugInitialConfigurations",
    "workspaceContains:**/*.tcl",
    "workspaceContains:**/*.test",
    "onTaskType:tcl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tcl",
        "aliases": [
          "TCL",
          "Tcl"
        ],
        "extensions": [
          ".tcl",
          ".tk",
          ".tm",
          ".test"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tcl",
        "scopeName": "source.tcl",
        "path": "./syntaxes/tcl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "TCL",
      "properties": {
        "tcl.format.alignBraces": {
          "type": "boolean",
          "default": true,
          "description": "Align opening and closing braces",
          "scope": "resource"
        },
        "tcl.format.spacesAroundOperators": {
          "type": "boolean",
          "default": true,
          "description": "Add spaces around operators",
          "scope": "resource"
        },
        "tcl.format.spacesInsideBraces": {
          "type": "boolean",
          "default": true,
          "description": "Add spaces inside braces",
          "scope": "resource"
        },
        "tcl.format.spacesInsideBrackets": {
          "type": "boolean",
          "default": false,
          "description": "Add spaces inside brackets",
          "scope": "resource"
        },
        "tcl.format.enable": {
          "type": "boolean",
          "default": false,
          "description": "Enable automatic TCL formatting on save",
          "scope": "resource"
        },
        "tcl.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable TCL syntax diagnostics"
        },
        "tcl.diagnostics.useTclsh": {
          "type": "boolean",
          "default": true,
          "description": "Use tclsh to check command completeness without executing document code"
        },
        "tcl.repl.tclPath": {
          "type": "string",
          "default": "tclsh",
          "description": "Path to TCL interpreter for REPL",
          "scope": "resource"
        },
        "tcl.test.tclPath": {
          "type": "string",
          "default": "tclsh",
          "description": "Path to TCL interpreter for running tests",
          "scope": "resource"
        },
        "tcl.interpreter.path": {
          "type": "string",
          "default": "tclsh",
          "description": "Path to the default TCL interpreter",
          "scope": "resource"
        },
        "tcl.interpreters.customPaths": {
          "type": "array",
          "default": [],
          "description": "Custom TCL interpreter paths"
        },
        "tcl.packages.autoDiscovery": {
          "type": "boolean",
          "default": true,
          "description": "Automatically discover TCL packages in workspace",
          "scope": "resource"
        },
        "tcl.packages.installDirectory": {
          "type": "string",
          "default": "",
          "description": "Default directory to install TCL packages to (must be on auto_path)",
          "scope": "resource"
        },
        "tcl.lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable TCL linting for style issues",
          "scope": "resource"
        },
        "tcl.lint.maxLineLength": {
          "type": "number",
          "default": 120,
          "description": "Maximum line length before warning (0 to disable)",
          "scope": "resource"
        },
        "tcl.lint.exprBracing": {
          "type": "boolean",
          "default": true,
          "description": "Warn when expr arguments are not braced",
          "scope": "resource"
        },
        "tcl.codeLens.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show TCL CodeLens actions",
          "scope": "resource"
        },
        "tcl.codeLens.references": {
          "type": "boolean",
          "default": true,
          "description": "Show procedure reference counts",
          "scope": "resource"
        },
        "tcl.codeLens.tests": {
          "type": "boolean",
          "default": true,
          "description": "Show Run and Debug actions for tests",
          "scope": "resource"
        },
        "tcl.analysis.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**"
          ],
          "description": "Glob patterns excluded from TCL workspace analysis"
        },
        "tcl.diagnostics.debounceMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000,
          "default": 200,
          "description": "Delay interpreter completeness checks after editing",
          "scope": "resource"
        },
        "tcl.lint.rules": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "enum": [
              "off",
              "error",
              "warning",
              "information",
              "hint"
            ]
          },
          "description": "Override lint severity by rule: expr-bracing, catch-no-var, switch-default, deprecated, line-length, global-shorthand",
          "scope": "resource"
        },
        "tcl.run.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Default script arguments",
          "scope": "resource"
        },
        "tcl.run.cwd": {
          "type": "string",
          "default": "",
          "description": "Script working directory (empty uses its workspace folder)",
          "scope": "resource"
        },
        "tcl.run.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Environment variables for running scripts",
          "scope": "resource"
        },
        "tcl.run.rememberArgs": {
          "type": "boolean",
          "default": false,
          "description": "Remember arguments entered with Run with Arguments",
          "scope": "resource"
        }
      }
    },
    "commands": [
      {
        "command": "tcl.formatDocument",
        "title": "TCL: Format Document"
      },
      {
        "command": "tcl.startREPL",
        "title": "TCL: Start REPL"
      },
      {
        "command": "tcl.evaluateSelection",
        "title": "TCL: Evaluate Selection in REPL"
      },
      {
        "command": "tcl.runCurrentFile",
        "title": "TCL: Run Current File in REPL"
      },
      {
        "command": "tcl.runTests",
        "title": "TCL: Run Tests"
      },
      {
        "command": "tcl.generateCoverage",
        "title": "TCL: Generate Test Coverage"
      },
      {
        "command": "tcl.clearCoverage",
        "title": "TCL: Clear Coverage Data"
      },
      {
        "command": "tcl.exportCoverageReport",
        "title": "TCL: Export Coverage Report"
      },
      {
        "command": "tcl.extractProcedure",
        "title": "TCL: Extract Procedure"
      },
      {
        "command": "tcl.extractVariable",
        "title": "TCL: Extract Variable"
      },
      {
        "command": "tcl.inlineVariable",
        "title": "TCL: Inline Variable"
      },
      {
        "command": "tcl.inlineProcedure",
        "title": "TCL: Inline Procedure"
      },
      {
        "command": "tcl.extractNamespace",
        "title": "TCL: Extract to Namespace"
      },
      {
        "command": "tcl.selectInterpreter",
        "title": "TCL: Select Interpreter"
      },
      {
        "command": "tcl.addCustomInterpreter",
        "title": "TCL: Add Custom Interpreter"
      },
      {
        "command": "tcl.refreshInterpreters",
        "title": "TCL: Refresh Interpreters"
      },
      {
        "command": "tcl.createPackage",
        "title": "TCL: Create Package"
      },
      {
        "command": "tcl.updatePackageIndex",
        "title": "TCL: Update Package Index"
      },
      {
        "command": "tcl.newProject",
        "title": "TCL: New Project"
      },
      {
        "command": "tcl.installDependencies",
        "title": "TCL: Install Dependencies"
      },
      {
        "command": "tcl.updateDependencies",
        "title": "TCL: Update Dependencies"
      },
      {
        "command": "tcl.refreshDependencies",
        "title": "TCL: Refresh Dependencies"
      },
      {
        "command": "tcl.createDependencyReport",
        "title": "TCL: Create Dependency Report"
      },
      {
        "command": "tcl.runBuild",
        "title": "TCL: Run Build Task"
      },
      {
        "command": "tcl.runTask",
        "title": "TCL: Run Task"
      },
      {
        "command": "tcl.runTestTask",
        "title": "TCL: Run Test Task"
      },
      {
        "command": "tcl.configureTasks",
        "title": "TCL: Configure Tasks"
      },
      {
        "command": "tcl.runWithInterpreter",
        "title": "TCL: Run with Interpreter..."
      },
      {
        "command": "tcl.runWithArgs",
        "title": "TCL: Run with Arguments..."
      },
      {
        "command": "tcl.runTestItem",
        "title": "TCL: Run Selected Test"
      }
    ],
    "snippets": [
      {
        "language": "tcl",
        "path": "./snippets/tcl.json"
      }
    ],
    "breakpoints": [{ "language": "tcl" }],
    "debuggers": [
      {
        "type": "tcl",
        "label": "TCL Debug",
        "languages": ["tcl"],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to a TCL file.",
                "default": "${workspaceFolder}/${command:AskForProgramName}"
              },
              "tclPath": {
                "type": "string",
                "description": "Path to TCL interpreter",
                "default": "tclsh"
              },
              "args": {
                "type": "array",
                "description": "Arguments passed to the program",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "description": "Environment variables",
                "default": {}
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop on entry",
                "default": true
              },
              "debugThreads": {
                "type": "boolean",
                "default": false,
                "description": "Debug newly created Tcl Thread workers with independent pause and stepping"
              }
            }
          },
          "attach": {
            "required": [
              "port",
              "token"
            ],
            "properties": {
              "host": {
                "type": "string",
                "default": "127.0.0.1",
                "description": "Loopback address; use an SSH tunnel for a remote target"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "Port of an independently started TCL debug server"
              },
              "token": {
                "type": "string",
                "minLength": 16,
                "description": "Token matching the server TCL_DEBUG_TOKEN environment variable"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "sourceFileMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "description": "Remote source directory prefixes mapped to local directory prefixes"
              },
              "connectTimeout": {
                "type": "integer",
                "minimum": 1,
                "default": 10000,
                "description": "Connection timeout in milliseconds"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tcl",
            "request": "launch",
            "name": "Launch TCL",
            "program": "${file}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "TCL: Launch",
            "description": "A new configuration for launching a TCL program",
            "body": {
              "type": "tcl",
              "request": "launch",
              "name": "Launch TCL",
              "program": "^\"\\${workspaceFolder}/\\${command:AskForProgramName}\"",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "tcl",
        "required": [],
        "properties": {
          "script": {
            "type": "string",
            "description": "TCL script path"
          },
          "command": {
            "type": "string",
            "description": "Package action: run_tests, build_package, install_deps, package"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "interpreter": {
            "type": "string"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "tcl",
        "owner": "tcl",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^\\s*\\(file \"(.+)\" line (\\d+)\\)\\s*$",
          "file": 1,
          "line": 2,
          "message": 0
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-scripts",
    "copy-scripts": "node -e \"const fs=require('fs'),p=require('path');const s=p.join('src','debug','scripts'),d=p.join('out','debug','scripts');fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(f=>fs.copyFileSync(p.join(s,f),p.join(d,f)))\"",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "oxlint src",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "test:unit": "npm run compile && node ./out/test/runUnitTests.js",
    "test:integration": "npm test"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.136.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "glob": "^13.0.6",
    "mocha": "^12.0.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.1.1"
  }
}
